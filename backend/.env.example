# Backend environment — copy to .env and fill in values

# Firebase service account — path to your downloaded serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=shiftsure-a34e9

# OpenWeatherMap free-tier API key
OWM_API_KEY=your-openweathermap-key

# AI service base URL (local dev)
AI_SERVICE_URL=http://localhost:8001

# Express port
PORT=3000

# Shared secret sent to the AI service as X-Internal-Token (must match ai AI_SERVICE_TOKEN).
# Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call the API (admin dashboard).
# Unset = any origin in local dev, none when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Payout mode: "simulated" (default — wallet ledger only, no money moves) or
# "razorpayx" (REAL UPI payouts; also needs every RAZORPAYX_* value below).
# Keep this "simulated" for the demo.
PAYOUT_MODE=simulated

# RazorpayX UPI payouts — only used when PAYOUT_MODE=razorpayx
# Allowlist the backend server IP in RazorpayX and set the webhook URL to:
# https://<your-host>/api/wallet/webhooks/razorpay
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_PAYOUT_PURPOSE=payout
RAZORPAYX_QUEUE_IF_LOW_BALANCE=false
